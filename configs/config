[global_config]
  geometry_hinting = True
  title_transmit_fg_color = "#380c2a"
  title_transmit_bg_color = "#8ae234"
  title_inactive_fg_color = "#ffffff"
  title_inactive_bg_color = "#c80003"
  inactive_color_offset = 0.6098484848484849
[keybindings]
  split_horiz = <Primary><Shift>h
  split_vert = <Primary><Shift>j
  move_tab_right = <Primary>Right
  move_tab_left = <Primary>Left
  next_tab = <Primary>Right
  prev_tab = <Primary>Left
  switch_to_tab_1 = <Alt>1
  switch_to_tab_2 = <Alt>2
  switch_to_tab_3 = <Alt>3
  switch_to_tab_4 = <Alt>4
  switch_to_tab_5 = <Alt>5
  switch_to_tab_6 = <Alt>6
  switch_to_tab_7 = <Alt>7
  switch_to_tab_8 = <Alt>8
  switch_to_tab_9 = <Alt>9
  switch_to_tab_10 = <Alt>0
[profiles]
  [[default]]
    cursor_color = "#aaaaaa"
    font = Ubuntu Mono 20
    scrollback_infinite = True
    use_system_font = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
